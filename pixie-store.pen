                  "fontFamily": "Nunito",
                  "fontSize": 17,
                  "fontWeight": "900"
                },
                {
                  "type": "text",
                  "id": "ni2SU",
                  "name": "D",
                  "fill": "#2A5F7C",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Cada sección entra una sola vez al cruzar el 15% del viewport: opacity 0→1 + translateY 24→0 px + blur 6→0, 420 ms, ease-out exponencial (cubic-bezier(.16,1,.3,1)). Las tarjetas internas en cascada de 50 ms. Las secciones fuera de pantalla no se renderizan hasta acercarse (lazy con IntersectionObserver + React.lazy para Reseñas/Productos; imágenes loading=lazy).",
                  "lineHeight": 1.5,
                  "fontFamily": "Nunito",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
